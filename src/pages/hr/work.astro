<style is:global>
    .work-layout { display: grid; grid-template-columns: 420px 1fr; width: 100%; min-height: calc(100vh - 45px); }
    .work-sidebar { padding: 2.5rem 2.5rem 2.5rem 2rem; border-right: 1px solid var(--border-color); display: flex; flex-direction: column; position: sticky; top: 45px; height: calc(100vh - 45px); }
    .work-title { font-size: 3.2rem; font-weight: 500; line-height: 1.05; letter-spacing: -0.03em; margin-bottom: 1.5rem; }
    .work-description { font-size: 0.95rem; color: var(--text-muted); line-height: 1.5; font-weight: 500; margin-bottom: 3rem; }

    .category-filters { display: flex; flex-direction: column; gap: 0.8rem; font-size: 0.95rem; font-weight: 500; }
    .filter-btn { background: none; border: none; color: var(--text-muted); text-align: left; cursor: pointer; transition: color 0.2s ease; padding: 0.2rem 0; font-family: inherit; font-size: 0.95rem; font-weight: 500; width: fit-content; }
    .filter-btn:hover, .filter-btn.active { color: var(--text-main); }

    .work-content { padding: 2.5rem 2rem 5rem 2.5rem; width: 100%; max-width: 1040px; }
    .projects-2grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.5rem 2rem; width: 100%; }

    .project-card { display: flex; flex-direction: column; width: 100%; transition: opacity 0.3s ease; }
    .project-card.hidden { display: none; }

    .project-media { width: 100%; aspect-ratio: 4 / 3; background-color: var(--card-bg); overflow: hidden; margin-bottom: 0.7rem; }
    .project-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s ease; }
    .project-card:hover .project-media img { transform: scale(1.03); }

    .project-meta { display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; font-weight: 500; }
    .project-title-group { display: flex; align-items: center; gap: 0.5rem; }
    .project-category, .project-year { color: var(--text-muted); }
    .project-arrow { color: var(--text-muted); font-size: 0.8rem; transform: rotate(-45deg); display: inline-block; }

    .empty-notice { grid-column: span 2; font-size: 1rem; color: var(--text-muted); font-weight: 500; padding: 3rem 0; display: none; }

    @media (max-width: 1024px) {
        .work-layout { display: flex; flex-direction: column; }
        .work-sidebar { position: relative; top: 0; height: auto; border-right: none; border-bottom: 1px solid var(--border-color); padding: 2.5rem 1.5rem !important; }
        .work-content { padding: 2.5rem 1.5rem !important; max-width: 100%; }
        .projects-2grid { grid-template-columns: 1fr; gap: 2rem; }
        .category-filters { flex-direction: row; gap: 1.5rem; }
    }
</style>