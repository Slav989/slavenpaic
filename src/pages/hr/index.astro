    <CookieBanner />

    <script>
        import Lenis from 'lenis';
        const lenis = new Lenis({ duration: 1.2, easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), smoothWheel: true });
        function raf(time: number) { lenis.raf(time); requestAnimationFrame(raf); }
        requestAnimationFrame(raf);

        const yearEl = document.getElementById('year');
        if (yearEl) yearEl.textContent = new Date().getFullYear().toString();

        const cursor = document.getElementById('cursor');
        let mouseX = 0, mouseY = 0;
        let cursorX = 0, cursorY = 0;
        let cursorVisible = false;

        document.addEventListener('mousemove', (e) => { 
            mouseX = e.clientX; 
            mouseY = e.clientY; 
            if (!cursorVisible && cursor) {
                cursor.style.opacity = '1';
                cursorVisible = true;
            }
        });

        function renderCursor() {
            cursorX += (mouseX - cursorX) * 0.28;
            cursorY += (mouseY - cursorY) * 0.28;
            if (cursor) {
                cursor.style.left = cursorX + 'px';
                cursor.style.top = cursorY + 'px';
            }
            requestAnimationFrame(renderCursor);
        }
        renderCursor();

        const projectMedias = document.querySelectorAll('.project-media');
        projectMedias.forEach(media => {
            media.addEventListener('mouseenter', () => { cursor?.classList.add('hover-project'); });
            media.addEventListener('mouseleave', () => { cursor?.classList.remove('hover-project'); });
        });
    </script>
</Layout>

<style is:global>
    @font-face { font-family: 'General Sans'; src: url('/fonts/GeneralSans-Medium.woff2') format('woff2'); font-weight: 400 500; font-style: normal; font-display: swap; }
    @font-face { font-family: 'General Sans'; src: url('/fonts/GeneralSans-Bold.woff2') format('woff2'); font-weight: 700; font-style: normal; font-display: swap; }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
        --bg-color: #FFFFFF;
        --text-main: #121212;
        --text-muted: #757575;
        --border-color: #E5E5E5;
        --card-bg: #F4F4F4;
        --font-main: 'General Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        --scrollbar-bg: #F5F5F5;
        --scrollbar-thumb: #E63946;
    }

    [data-theme="dark"] {
        --bg-color: #0D0D0D;
        --text-main: #F0F0F0;
        --text-muted: #888888;
        --border-color: #242424;
        --card-bg: #161616;
        --scrollbar-bg: #121212;
        --scrollbar-thumb: #FF4D4D;
    }

    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: var(--scrollbar-bg); }
    ::-webkit-scrollbar-thumb { background: var(--scrollbar-thumb); border-radius: 0; }

    body {
        background-color: var(--bg-color);
        color: var(--text-main);
        font-family: var(--font-main);
        -webkit-font-smoothing: antialiased;
        line-height: 1.4;
        width: 100%;
        cursor: default;
        transition: background-color 0.3s ease, color 0.3s ease;
    }

    a, button, .project-card { color: inherit; text-decoration: none !important; border: none !important; outline: none; cursor: pointer; }

    .link-underline { position: relative; display: inline-block; width: fit-content; text-decoration: none !important; border: none !important; }
    .link-underline::after { content: ''; position: absolute; width: 100%; height: 1px; bottom: -1px; left: 0; background-color: var(--text-main); transform: scaleX(0); transform-origin: bottom left; transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
    .link-underline:hover::after { transform: scaleX(1); }

    /* ČETVRTASTI CURSOR BUTTON */
    .custom-cursor { 
        position: fixed; 
        top: 0; 
        left: 0; 
        width: 12px; 
        height: 12px; 
        background-color: var(--text-main); 
        border-radius: 50%; 
        pointer-events: none; 
        z-index: 9999; 
        transform: translate(-50%, -50%); 
        will-change: transform, width, height, border-radius, padding; 
        transition: width 0.35s cubic-bezier(0.16, 1, 0.3, 1), height 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-radius 0.3s ease, padding 0.3s ease, opacity 0.2s ease; 
        display: flex; 
        align-items: center; 
        justify-content: center; 
        opacity: 0; 
    }
    .custom-cursor-text { font-size: 0.8rem; font-weight: 500; color: var(--bg-color); opacity: 0; white-space: nowrap; transition: opacity 0.2s ease; user-select: none; }
    
    .custom-cursor.hover-project { 
        width: auto !important; 
        height: auto !important; 
        padding: 12px 40px !important; 
        border-radius: 4px !important; 
        background-color: var(--text-main) !important; 
    }
    .custom-cursor.hover-project .custom-cursor-text { opacity: 1 !important; }

    @keyframes fadeInUp { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
    .animate-fade { opacity: 0; animation: fadeInUp 0.85s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    .delay-1 { animation-delay: 0.05s; }
    .delay-2 { animation-delay: 0.15s; }
    .delay-3 { animation-delay: 0.25s; }
    .delay-4 { animation-delay: 0.35s; }

    .portfolio-grid { display: grid; grid-template-columns: 360px 1fr 360px; align-items: start; width: 100%; min-height: calc(100vh - 45px); }
    .col { padding: 2.5rem 2rem; }
    .col-left { border-right: 1px solid var(--border-color); display: flex; flex-direction: column; justify-content: space-between; position: sticky; top: 45px; height: calc(100vh - 45px); }
    .col-middle { border-right: 1px solid var(--border-color); padding: 2.5rem 2rem; width: 100%; }
    .col-right { display: flex; flex-direction: column; justify-content: space-between; position: sticky; top: 45px; height: calc(100vh - 45px); }

    .hero-title { font-size: 2.8rem; font-weight: 500; line-height: 1.1; letter-spacing: -0.03em; margin-bottom: 2rem; white-space: pre-line; }
    .socials-list { display: flex; gap: 1.2rem; margin-bottom: 3rem; }
    .social-icon { width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; transition: transform 0.2s ease, color 0.2s ease; }
    .social-icon:hover { transform: translateY(-2px); color: var(--text-muted); }

    .services-container { margin-top: auto; }
    .services-list { display: flex; flex-direction: column; gap: 0.2rem; }
    .service-item { font-size: 0.88rem; font-weight: 500; padding-bottom: 0.3rem; color: var(--text-main); border-bottom: 1px solid var(--border-color); }
    .service-item:last-child { border-bottom: none; }

    .bio-statement { font-size: 1.35rem; font-weight: 500; line-height: 1.35; letter-spacing: -0.02em; margin-bottom: 6.5rem; color: var(--text-main); max-width: 85%; }
    .bio-statement .muted { color: var(--text-muted); }

    .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; font-size: 0.92rem; font-weight: 500; width: 100%; }
    .section-header h3 { font-weight: 500; }
    .section-count { color: var(--text-muted); font-weight: 500; }

    .projects-stack { display: flex; flex-direction: column; gap: 2.5rem; width: 100%; }
    .project-media { width: 100%; aspect-ratio: 16 / 10; background-color: var(--card-bg); overflow: hidden; margin-bottom: 0.7rem; }
    .project-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s ease, filter 0.5s ease; }
    .project-card:hover .project-media img { transform: scale(1.03); filter: brightness(0.95); }

    .project-meta { display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; font-weight: 500; }
    .project-title-group { display: flex; align-items: center; gap: 0.5rem; }
    .project-category, .project-year { color: var(--text-muted); }
    .project-arrow { color: var(--text-muted); font-size: 0.8rem; transform: rotate(-45deg); display: inline-block; }

    .availability-tag { display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; font-weight: 500; margin-bottom: 1.5rem; }
    .dot { width: 6px; height: 6px; background-color: #22C55E; border-radius: 50%; }

    .profile-card { width: 100%; margin-bottom: 1.5rem; }
    .profile-img-wrapper { width: 100%; aspect-ratio: 3 / 4; overflow: hidden; margin-bottom: 1rem; background-color: var(--card-bg); }
    .profile-image { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1); }
    .profile-img-wrapper:hover .profile-image { transform: scale(1.04); }

    .profile-info { text-align: right; font-size: 0.85rem; line-height: 1.5; font-weight: 500; }
    .profile-info .studio-brand-link { color: var(--text-muted); }
    .profile-info .studio-brand-link:hover { color: var(--text-main); }

    .contact-box { display: flex; flex-direction: column; gap: 0.4rem; margin-top: auto; width: 100%; }
    .contact-link { font-size: 0.88rem; font-weight: 500; display: block; }
    .contact-bottom-row { display: flex; justify-content: space-between; align-items: center; width: 100%; }
    .copyright { font-size: 0.8rem; color: var(--text-muted); }

    .studio-brand-link { color: var(--text-muted) !important; font-weight: 500 !important; }
    .studio-brand-link:hover { color: var(--text-main) !important; }

    @media (max-width: 1024px) {
        .portfolio-grid { display: flex; flex-direction: column; }
        .col, .col-left, .col-middle, .col-right { padding-left: 1.5rem !important; padding-right: 1.5rem !important; }
        .col-left { order: 1; position: relative; top: 0; height: auto; border-right: none; border-bottom: 1px solid var(--border-color); width: 100%; padding-left: 1.5rem !important; }
        .col-right { order: 2; position: relative; top: 0; height: auto; border-right: none; border-bottom: 1px solid var(--border-color); width: 100%; }
        .col-middle { order: 3; border-right: none; border-bottom: 1px solid var(--border-color); padding: 2.5rem 1.5rem; }
        .bio-statement { margin-bottom: 3.5rem; max-width: 100%; }
        .custom-cursor { display: none; }
    }
</style>