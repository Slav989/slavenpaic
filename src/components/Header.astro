---
const pathname = Astro.url.pathname;
const currentPath = pathname.endsWith('/') && pathname.length > 1 ? pathname.slice(0, -1) : pathname;

const isHr = currentPath.startsWith('/hr');
const cleanPath = isHr ? (currentPath.replace(/^\/hr/, '') || '/') : currentPath;

const enUrl = cleanPath;
const hrUrl = cleanPath === '/' ? '/hr' : `/hr${cleanPath}`;

const homeLink = isHr ? '/hr' : '/';
const infoLink = isHr ? '/hr/info' : '/info';
const workLink = isHr ? '/hr/work' : '/work';
const contactLink = isHr ? '/hr/contact' : '/contact';

const navText = isHr 
  ? { home: 'Početna,', info: 'Info,', work: 'Radovi,', contact: 'Kontakt', call: 'Rezerviraj poziv' }
  : { home: 'Home,', info: 'Info,', work: 'Work,', contact: 'Contact', call: 'Book a Call' };
---

<header class="site-header animate-fade delay-1">
    <div class="header-logo">
        <a href={homeLink}>
            <img src="/logo-sp.svg" alt="SP Studio Logo" class="header-logo-img">
        </a>
    </div>

    <nav class="header-nav">
        <a href={homeLink} class={currentPath === homeLink ? 'active' : ''}>{navText.home}</a>
        <a href={infoLink} class={currentPath === infoLink ? 'active' : ''}>{navText.info}</a>
        <a href={workLink} class={currentPath === workLink ? 'active' : ''}>{navText.work}</a>
        <a href={contactLink} class={currentPath === contactLink ? 'active' : ''}>{navText.contact}</a>
    </nav>

    <div class="header-right">
        <div class="lang-switch">
            {isHr ? (
                <a href={enUrl}>EN</a><span> / </span><span class="active">HR</span>
            ) : (
                <span class="active">EN</span><span> / </span><a href={hrUrl}>HR</a>
            )}
        </div>

        <button type="button" class="theme-toggle-btn" aria-label="Preklopi temu">
            <svg class="theme-icon sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
            <svg class="theme-icon moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>

        <a href="https://calendly.com/sp-studio/30-minute-discovery-call" target="_blank" rel="noopener" class="link-underline" style="font-weight: 500;">{navText.call}</a>
    </div>

    <button type="button" class="hamburger-btn" id="hamburger-toggle" aria-label="Toggle menu">
        <span class="line line-1"></span>
        <span class="line line-2"></span>
    </button>
</header>

<!-- MOBILE OVERLAY MENU -->
<div class="mobile-menu-overlay" id="mobile-menu">
    <nav class="mobile-nav-links">
        <a href={homeLink} class={currentPath === homeLink ? 'active' : ''}>{navText.home}</a>
        <a href={infoLink} class={currentPath === infoLink ? 'active' : ''}>{navText.info}</a>
        <a href={workLink} class={currentPath === workLink ? 'active' : ''}>{navText.work}</a>
        <a href={contactLink} class={currentPath === contactLink ? 'active' : ''}>{navText.contact}</a>
    </nav>

    <div class="mobile-menu-bottom">
        <div class="mobile-controls-row">
            <div class="lang-switch">
                {isHr ? (
                    <a href={enUrl}>EN</a><span> / </span><span class="active">HR</span>
                ) : (
                    <span class="active">EN</span><span> / </span><a href={hrUrl}>HR</a>
                )}
            </div>
            <button type="button" class="theme-toggle-btn" aria-label="Preklopi temu">
                <svg class="theme-icon sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                <svg class="theme-icon moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            </button>
        </div>
        <a href="https://calendly.com/sp-studio/30-minute-discovery-call" target="_blank" rel="noopener" class="link-underline" style="align-self: flex-start; font-size: 1.05rem; font-weight: 500;">{navText.call} →</a>
    </div>
</div>

<script is:inline>
    (function() {
        var savedTheme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', savedTheme);
    })();

    function bindHeaderEvents() {
        var btn = document.getElementById('hamburger-toggle');
        var menu = document.getElementById('mobile-menu');

        if (btn && menu) {
            btn.onclick = null;
            btn.onclick = function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                var isOpen = menu.style.display === 'flex';

                if (isOpen) {
                    menu.style.setProperty('display', 'none', 'important');
                    btn.classList.remove('is-active');
                    document.body.style.overflow = '';
                } else {
                    menu.style.setProperty('display', 'flex', 'important');
                    btn.classList.add('is-active');
                    document.body.style.overflow = 'hidden';
                }
            };

            var links = menu.getElementsByTagName('a');
            for (var i = 0; i < links.length; i++) {
                links[i].onclick = function() {
                    menu.style.setProperty('display', 'none', 'important');
                    btn.classList.remove('is-active');
                    document.body.style.overflow = '';
                };
            }
        }

        var themeBtns = document.querySelectorAll('.theme-toggle-btn');
        themeBtns.forEach(function(tb) {
            tb.onclick = function(e) {
                e.preventDefault();
                e.stopPropagation();
                var current = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
                var next = current === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', next);
                localStorage.setItem('theme', next);
            };
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bindHeaderEvents);
    } else {
        bindHeaderEvents();
    }
    document.addEventListener('astro:page-load', bindHeaderEvents);
</script>

<style is:global>
    .site-header {
        position: sticky;
        top: 0;
        z-index: 99999 !important; /* Spušteno ispod kursora */
        background: var(--bg-color);
        border-bottom: 1px solid var(--border-color);
        display: grid;
        grid-template-columns: 360px 1fr 360px;
        align-items: center;
        padding: 0.5rem 2rem;
        width: 100%;
        font-size: 0.88rem;
        font-weight: 500;
        transition: background-color 0.3s ease, border-color 0.3s ease;
    }

    .header-logo { display: flex; align-items: center; }
    .header-logo-img { height: 22px; width: auto; display: block; transition: filter 0.3s ease; }
    html[data-theme="dark"] .header-logo-img { filter: invert(1); }

    .header-nav { display: flex; align-items: center; justify-content: center; gap: 0.5rem; color: var(--text-muted); }
    .header-nav a:hover, .header-nav a.active { color: var(--text-main); }

    .header-right { display: flex; justify-content: flex-end; align-items: center; gap: 1.2rem; }
    .lang-switch { display: inline-flex; gap: 0.2rem; color: var(--text-muted); font-size: 0.82rem; font-weight: 500; }
    .lang-switch span.active { color: var(--text-main); }

    .theme-toggle-btn {
        background: none;
        border: 1px solid var(--border-color) !important;
        color: var(--text-main);
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        padding: 0;
    }
    .theme-toggle-btn * { pointer-events: none; }
    .theme-toggle-btn:hover { border-color: var(--text-main) !important; transform: scale(1.05); }

    .sun-icon { display: block !important; }
    .moon-icon { display: none !important; }

    html[data-theme="dark"] .sun-icon { display: none !important; }
    html[data-theme="dark"] .moon-icon { display: block !important; }

    /* HAMBURGER DUGME - ČISTI RESET I ZAKUCANE LINIJE */
    .hamburger-btn {
        display: none;
        background: none !important;
        background-color: transparent !important;
        border: none !important;
        outline: none !important;
        -webkit-appearance: none !important;
        appearance: none !important;
        flex-direction: column;
        gap: 5px;
        align-items: flex-end;
        justify-content: center;
        cursor: pointer;
        padding: 10px;
        margin-right: -10px;
        z-index: 100001;
        position: relative;
        box-shadow: none !important;
    }

    .hamburger-btn * { pointer-events: none; }

    /* DEBLJINA 2PX ELIMINIRA SUB-PIXEL SIVILO */
    .hamburger-btn .line,
    .hamburger-btn .line-1,
    .hamburger-btn .line-2 {
        display: block !important;
        height: 2px !important;
        background-color: var(--text-main) !important;
        opacity: 1 !important;
        border: none !important;
        box-shadow: none !important;
        transition: transform 0.3s ease, width 0.3s ease !important;
    }

    .hamburger-btn .line-1 { width: 22px !important; }
    .hamburger-btn .line-2 { width: 14px !important; }

    .hamburger-btn.is-active .line-1 { transform: translateY(3.5px) rotate(45deg) !important; width: 20px !important; }
    .hamburger-btn.is-active .line-2 { transform: translateY(-3.5px) rotate(-45deg) !important; width: 20px !important; }

    .mobile-menu-overlay {
        display: none;
        position: fixed;
        top: 52px;
        left: 0;
        width: 100vw;
        height: calc(100vh - 52px);
        height: calc(100dvh - 52px);
        background-color: var(--bg-color);
        z-index: 99998;
        flex-direction: column;
        justify-content: space-between;
        padding: 2.5rem 1.5rem 2.5rem 1.5rem;
        box-sizing: border-box;
    }

    .mobile-nav-links {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        font-size: 1.6rem;
        font-weight: 500;
    }

    .mobile-nav-links a { color: var(--text-muted); }
    .mobile-nav-links a.active, .mobile-nav-links a:hover { color: var(--text-main); }

    .mobile-menu-bottom {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
        padding-top: 1.2rem;
        border-top: 1px solid var(--border-color);
    }

    .mobile-controls-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
    }

    /* GLOBALNI KURSOR SE POSTAVLJA IZNAD SVEGA */
    .custom-cursor {
        z-index: 9999999 !important;
        background-color: #FFFFFF !important;
        mix-blend-mode: difference !important;
    }

    @media (max-width: 1024px) {
        .site-header { display: flex; justify-content: space-between; padding: 0.8rem 1.5rem; }
        .header-nav, .header-right { display: none; }
        .hamburger-btn { display: flex !important; }
    }
</style>