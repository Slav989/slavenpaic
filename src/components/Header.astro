---
const pathname = Astro.url.pathname;
const currentPath = pathname.endsWith('/') && pathname.length > 1 ? pathname.slice(0, -1) : pathname;

// Provjera jezika i izračun dinamčkih putanja za switcher i navigaciju
const isHr = currentPath.startsWith('/hr');
const cleanPath = isHr ? (currentPath.replace(/^\/hr/, '') || '/') : currentPath;

const enUrl = cleanPath;
const hrUrl = cleanPath === '/' ? '/hr' : `/hr${cleanPath}`;

const homeLink = isHr ? '/hr' : '/';
const infoLink = isHr ? '/hr/info' : '/info';
const workLink = isHr ? '/hr/work' : '/work';
const contactLink = isHr ? '/hr/contact' : '/contact';

const navText = isHr 
  ? { home: 'Početna,', info: 'Info,', work: 'Radovi,', contact: 'Kontakt', call: 'Rezerviraj poziv' }
  : { home: 'Home,', info: 'Info,', work: 'Work,', contact: 'Contact', call: 'Book a Call' };
---

<header class="site-header animate-fade delay-1">
    <div class="header-logo">
        <a href={homeLink}>
            <img src="/logo-sp.svg" alt="SP Studio Logo" class="header-logo-img">
        </a>
    </div>

    <nav class="header-nav">
        <a href={homeLink} class={currentPath === homeLink ? 'active' : ''}>{navText.home}</a>
        <a href={infoLink} class={currentPath === infoLink ? 'active' : ''}>{navText.info}</a>
        <a href={workLink} class={currentPath === workLink ? 'active' : ''}>{navText.work}</a>
        <a href={contactLink} class={currentPath === contactLink ? 'active' : ''}>{navText.contact}</a>
    </nav>

    <div class="header-right">
        <div class="lang-switch">
            {isHr ? (
                <a href={enUrl}>EN</a><span> / </span><span class="active">HR</span>
            ) : (
                <span class="active">EN</span><span> / </span><a href={hrUrl}>HR</a>
            )}
        </div>

        <button class="theme-toggle-btn" id="theme-toggle" aria-label="Preklopi temu">
            <svg class="theme-icon sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
            <svg class="theme-icon moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>

        <a href="https://calendly.com/sp-studio/30-minute-discovery-call" target="_blank" rel="noopener" class="link-underline" style="font-weight: 500;">{navText.call}</a>
    </div>

    <button class="hamburger-btn" id="hamburger-toggle" aria-label="Toggle menu">
        <span class="line line-1"></span>
        <span class="line line-2"></span>
    </button>
</header>

<!-- MOBILE OVERLAY MENU -->
<div class="mobile-menu-overlay" id="mobile-menu">
    <nav class="mobile-nav-links">
        <a href={homeLink} class={currentPath === homeLink ? 'active' : ''}>{navText.home}</a>
        <a href={infoLink} class={currentPath === infoLink ? 'active' : ''}>{navText.info}</a>
        <a href={workLink} class={currentPath === workLink ? 'active' : ''}>{navText.work}</a>
        <a href={contactLink} class={currentPath === contactLink ? 'active' : ''}>{navText.contact}</a>
    </nav>

    <div class="mobile-menu-bottom">
        <div class="mobile-controls-row">
            <div class="lang-switch">
                {isHr ? (
                    <a href={enUrl}>EN</a><span> / </span><span class="active">HR</span>
                ) : (
                    <span class="active">EN</span><span> / </span><a href={hrUrl}>HR</a>
                )}
            </div>
            <button class="theme-toggle-btn theme-toggle-mobile" aria-label="Preklopi temu">
                <svg class="theme-icon sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle></svg>
                <svg class="theme-icon moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            </button>
        </div>
        <a href="https://calendly.com/sp-studio/30-minute-discovery-call" target="_blank" rel="noopener" class="link-underline" style="align-self: flex-start; font-size: 1.1rem; font-weight: 500;">{navText.call} →</a>
    </div>
</div>

<script is:inline>
    function applyTheme(theme) {
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('theme', theme);
        
        const sunIcons = document.querySelectorAll('.sun-icon');
        const moonIcons = document.querySelectorAll('.moon-icon');
        
        sunIcons.forEach(icon => icon.style.display = theme === 'dark' ? 'none' : 'block');
        moonIcons.forEach(icon => icon.style.display = theme === 'dark' ? 'block' : 'none');
    }

    const savedTheme = localStorage.getItem('theme') || 'light';
    applyTheme(savedTheme);

    document.addEventListener('DOMContentLoaded', () => {
        const toggleBtns = document.querySelectorAll('#theme-toggle, .theme-toggle-mobile');
        toggleBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const current = document.documentElement.getAttribute('data-theme') || 'light';
                applyTheme(current === 'light' ? 'dark' : 'light');
            });
        });

        const hamburgerBtn = document.getElementById('hamburger-toggle');
        const mobileMenu = document.getElementById('mobile-menu');
        hamburgerBtn?.addEventListener('click', () => {
            hamburgerBtn.classList.toggle('is-active');
            mobileMenu?.classList.toggle('is-open');
        });
    });
</script>