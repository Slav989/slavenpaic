---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  activePage?: 'home' | 'info' | 'work' | 'contact';
}

const { title, activePage = 'home' } = Astro.props;
---

<!DOCTYPE html>
<html lang="hr" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- FAVICON -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png?v=3" />
    
    <!-- ZABRANA SEO INDEKSIRANJA -->
    <meta name="robots" content="noindex, nofollow" />

    <title>{title}</title>
    <link rel="stylesheet" href="https://unpkg.com/lenis@1.1.18/dist/lenis.css" />
  </head>
  <body>

    <div class="custom-cursor" id="cursor">
      <span class="custom-cursor-text">View project</span>
    </div>

    <!-- HEADER COMPONENT -->
    <Header activePage={activePage} />

    <!-- MAIN PAGE CONTENT -->
    <slot />

    <script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js"></script>
    <script>
      // Lenis Smooth Scroll
      const lenis = new Lenis({ duration: 1.2, easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), smoothWheel: true });
      function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
      requestAnimationFrame(raf);

      // Theme Toggle
      const themeTriggers = document.querySelectorAll('.theme-toggle-trigger');
      const htmlElement = document.documentElement;

      themeTriggers.forEach(btn => {
        btn.addEventListener('click', () => {
          const currentTheme = htmlElement.getAttribute('data-theme');
          const newTheme = currentTheme === 'light' ? 'dark' : 'light';
          htmlElement.setAttribute('data-theme', newTheme);
          themeTriggers.forEach(tBtn => {
            const sun = tBtn.querySelector('.sun-icon');
            const moon = tBtn.querySelector('.moon-icon');
            if (newTheme === 'dark') {
              if (sun) sun.style.display = 'none';
              if (moon) moon.style.display = 'block';
            } else {
              if (sun) sun.style.display = 'block';
              if (moon) moon.style.display = 'none';
            }
          });
        });
      });

      // Mobile Menu
      const hamburgerBtn = document.getElementById('hamburger-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileNavItems = document.querySelectorAll('.mobile-nav-item');

      if (hamburgerBtn && mobileMenu) {
        hamburgerBtn.addEventListener('click', () => {
          hamburgerBtn.classList.toggle('is-active');
          mobileMenu.classList.toggle('is-open');
        });

        mobileNavItems.forEach(item => {
          item.addEventListener('click', () => {
            hamburgerBtn.classList.remove('is-active');
            mobileMenu.classList.remove('is-open');
          });
        });
      }

      // Custom Cursor Logic
      function initCursor() {
        const cursor = document.getElementById('cursor');
        if (!cursor) return;

        let mouseX = 0, mouseY = 0;
        let cursorX = 0, cursorY = 0;
        let cursorVisible = false;

        document.addEventListener('mousemove', (e) => { 
          mouseX = e.clientX; 
          mouseY = e.clientY; 
          if (!cursorVisible) {
            cursor.style.opacity = '1';
            cursorVisible = true;
          }
        });

        function renderCursor() {
          cursorX += (mouseX - cursorX) * 0.28;
          cursorY += (mouseY - cursorY) * 0.28;
          cursor.style.left = cursorX + 'px';
          cursor.style.top = cursorY + 'px';
          requestAnimationFrame(renderCursor);
        }
        renderCursor();

        const projectSelectors = '.project-media, .project-card, .project-item, .work-item, .work-card, a[href*="/work/"]';

        document.addEventListener('mouseover', (e) => {
          const target = e.target as HTMLElement;
          if (target && target.closest(projectSelectors)) {
            cursor.classList.add('hover-project');
          }
        });

        document.addEventListener('mouseout', (e) => {
          const target = e.target as HTMLElement;
          if (target && target.closest(projectSelectors)) {
            cursor.classList.remove('hover-project');
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initCursor);
      } else {
        initCursor();
      }
      document.addEventListener('astro:page-load', initCursor);
    </script>
  </body>
</html>

<style is:global>
  /* 1. MALI KRUG KURSORA */
  .custom-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 12px;
    height: 12px;
    background-color: #FFFFFF !important;
    mix-blend-mode: difference !important;
    border-radius: 50% !important;
    pointer-events: none;
    z-index: 9999999 !important;
    transform: translate(-50%, -50%);
    will-change: transform, left, top, width, height;
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1), 
                height 0.3s cubic-bezier(0.16, 1, 0.3, 1), 
                padding 0.3s ease, 
                opacity 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
  }

  .custom-cursor-text {
    display: block !important;
    font-size: 0.82rem !important;
    font-weight: 500 !important;
    line-height: 1 !important;
    white-space: nowrap !important;
    user-select: none !important;
    opacity: 0 !important;
    transition: opacity 0.2s ease !important;
  }

  /* 2. HOVER GUMB PREKO PROJEKATA - UVIJEK BIJELI (#FFFFFF) S CRNIM TEKSTOM (#121212), BEZ BORDERA I NULTI RADIUS NA OBJE TEME */
  body .custom-cursor.hover-project,
  html .custom-cursor.hover-project,
  html[data-theme="light"] .custom-cursor.hover-project,
  html[data-theme="dark"] .custom-cursor.hover-project {
    width: auto !important;
    height: auto !important;
    padding: 12px 28px !important;
    border-radius: 0px !important;
    -webkit-border-radius: 0px !important;
    border: 0px none transparent !important;
    outline: none !important;
    box-shadow: none !important;
    mix-blend-mode: normal !important;
    background-color: #FFFFFF !important;
    opacity: 1 !important;
  }

  body .custom-cursor.hover-project .custom-cursor-text,
  html .custom-cursor.hover-project .custom-cursor-text,
  html[data-theme="light"] .custom-cursor.hover-project .custom-cursor-text,
  html[data-theme="dark"] .custom-cursor.hover-project .custom-cursor-text {
    opacity: 1 !important;
    color: #121212 !important;
  }

  @media (max-width: 1024px) {
    .custom-cursor {
      display: none !important;
    }
  }
</style>